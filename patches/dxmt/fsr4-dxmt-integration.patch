+static void
+fsr4_load_hook(void) {
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    const char *path = getenv("FSR4_DXMT_HOOK");
+    if (!path || !path[0])
+      return;
+    void *handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      NSLog(@"[fsr4] DXMT hook load failed: %s", dlerror());
+    else
+      NSLog(@"[fsr4] DXMT hook loaded: %s", path);
+  });
+}
+
