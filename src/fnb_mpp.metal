// FNB (FasterNetBlock) on mpp::tensor_ops::matmul2d — native MSL replacement
// for the generated fp16 FNB passes (f16_FNB<NF,NG>).
//
// Per-threadgroup tile = T output pixels (one row segment), 128 threads /
// 4 simdgroups. Two threadgroup buffers:
//   A    [T][64]  conv_result (K-padded); later reused as contract output C3.
//   Cbuf [T][2NF] expand matmul out; requant_relu in place -> relu_result
//         (its [T][2NF] layout is exactly the contract A operand).
//   1. scalar dw grouped conv3x3 (NF/2 outs) + passthrough upper half -> A
//   2. expand  pw conv NF->2NF  via matmul2d (weights pre-transposed [K][N])
//      bias + requant_relu in place -> Cbuf holds relu_result
//   3. contract pw conv 2NF->NF via matmul2d into A (aliased C3);
//      bias + residual + split-scale requant -> output tensor in scratch.
// Weight blob layout (mpp_weights.bin) and all offsets/strides come from the
// mpp_manifest.json generated by gen_f16.py and are passed via FnbParams.
//
// Requires Metal 4 (MTLLanguageVersion4_0 / -std=metal4.0).

#include <metal_stdlib>
#include <metal_tensor>
#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
using namespace metal;
using namespace mpp::tensor_ops;

struct FnbParams {
    uint4 inV;      // x: strideX, y: strideY, z: strideC(bytes), w: inOff
    uint4 outV;     // same for output tensor
    uint4 dims;     // x: W, y: H, z: C(unused)
    uint4 w0s;      // w0 element strides (x, y, c, f)
    uint4 w0d;      // w0 dims (kx, ky, ci, HF)
    uint4 offs0;    // w0, b0, w1t, b1 byte offsets into weight buffer
    uint4 offs1;    // w2t, b2
    uint4 gemm;     // x: K1 padded(=64), y: N1 (=2NF), z: K2 (=2NF), w: N2 (=NF)
    float4 scales;  // x: quantScale1 (dw requant), y: actScale (relu requant),
                    // z: quantOutputScale0 (i < NF/2), w: qo1 (i >= NF/2)
    uint4 misc;     // x: ciPerGroup, y: fPerGroup, z: ngroups
};

#define KPAD 64   // A tile K stride (NF <= 64 padded to one 64-chunk)

static inline float requant(float v, float s) {
    return clamp((float)round(v / s), -128.0f, 127.0f) * s;
}
static inline float requant_relu(float v, float s) {
    return clamp((float)round(v / s), 0.0f, 127.0f) * s;
}

template<int NF, int T, int PADS>
static void fnb_mpp_t(device uchar *scratch,
                      device const uchar *wgt,
                      constant FnbParams &p,
                      threadgroup half *A,     // [T][KPAD], reused as C3 [T][NF]
                      threadgroup half *Cbuf,  // [T][2NF]
                      uint2 tgid,
                      uint tid)
{
    constexpr int HF = NF / 2;
    const uint W = p.dims.x, H = p.dims.y;
    const uint x0 = tgid.x * T;
    const uint y = tgid.y;
    const uint ciPG = p.misc.x, fPG = p.misc.y;   // channels/group, outs/group

    device const half *w0 = (device const half *)(wgt + p.offs0.x);
    device const half *b0 = (device const half *)(wgt + p.offs0.y);
    device const half *b1 = (device const half *)(wgt + p.offs0.w);
    device const half *b2 = (device const half *)(wgt + p.offs1.y);

    // ---- phase 1: dw conv lower HF + passthrough upper, K-pad zeros ----
    for (uint w = tid; w < T * HF; w += 128) {
        uint px = w / HF, f = w % HF;
        uint g = f / fPG;
        int xi = (int)(x0 + px), yi = (int)y;
        float acc = float(b0[f]);
        for (uint ky = 0; ky < p.w0d.y; ky++)
            for (uint kx = 0; kx < p.w0d.x; kx++) {
                int xx = xi + (int)kx - 1, yy = yi + (int)ky - 1;
                if (xx < 0 || yy < 0 || xx >= (int)W || yy >= (int)H) continue;
                device const half *in = (device const half *)(
                    scratch + p.inV.w + (uint)xx * p.inV.x + (uint)yy * p.inV.y)
                    + g * ciPG;
                for (uint c = 0; c < ciPG; c += 4) {
                    half4 v = *(device const half4 *)(in + c);
                    device const half *wt = w0 + kx * p.w0s.x + ky * p.w0s.y
                                        + c * p.w0s.z + f * p.w0s.w;
                    acc += float(v.x) * float(wt[0])
                         + float(v.y) * float(wt[p.w0s.z])
                         + float(v.z) * float(wt[2 * p.w0s.z])
                         + float(v.w) * float(wt[3 * p.w0s.z]);
                }
            }
        A[px * KPAD + f] = half(requant(acc, p.scales.x));
    }
    // passthrough upper half
    for (uint w = tid; w < T * HF; w += 128) {
        uint px = w / HF, c = HF + w % HF;
        uint xi = x0 + px;
        half v = 0;
        if (xi < W) {
            device const half *in = (device const half *)(
                scratch + p.inV.w + xi * p.inV.x + y * p.inV.y);
            v = in[c];
        }
        A[px * KPAD + c] = v;
    }
    // zero pad [NF, KPAD)
    if (PADS)
        for (uint w = tid; w < T * (KPAD - NF); w += 128) {
            uint px = w / (KPAD - NF), c = NF + w % (KPAD - NF);
            A[px * KPAD + c] = half(0);
        }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    auto tA = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(
        A, dextents<int32_t, 2>(KPAD, T));
    auto tC = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(
        Cbuf, dextents<int32_t, 2>((int)p.gemm.y, T));

    constexpr auto d = matmul2d_descriptor(
        32, 32, 64, false, false, false,
        matmul2d_descriptor::mode::multiply_accumulate);
    matmul2d<d, execution_simdgroups<4>> op;

    // ---- phase 2: expand  A[T][K1] x W1t[K1][N1] -> Cbuf[T][N1] ----
    {
        device const half *w1 = (device const half *)(wgt + p.offs0.z);
        auto tW1 = tensor<device half, dextents<int32_t, 2>, tensor_inline>(
            (device half *)w1, dextents<int32_t, 2>((int)p.gemm.y, (int)p.gemm.x));
        for (uint i = tid; i < T * p.gemm.y; i += 128) Cbuf[i] = half(0);
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (uint m0 = 0; m0 < T; m0 += 32)
            for (uint n0 = 0; n0 < p.gemm.y; n0 += 32) {
                auto mA = tA.slice<64, 32>(0, (int)m0);
                auto mB = tW1.slice<32, 64>((int)n0, 0);
                auto mC = tC.slice<32, 32>((int)n0, (int)m0);
                op.run(mA, mB, mC);
            }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        // bias + requant_relu in place -> Cbuf is now relu_result
        for (uint w = tid; w < T * p.gemm.y; w += 128) {
            float v = float(Cbuf[w]) + float(b1[w % p.gemm.y]);
            Cbuf[w] = half(requant_relu(v, p.scales.y));
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    // ---- phase 3: contract Cbuf[T][K2] x W2t[K2][N2] -> A[T][NF] (aliased) --
    {
        device const half *w2 = (device const half *)(wgt + p.offs1.x);
        auto tW2 = tensor<device half, dextents<int32_t, 2>, tensor_inline>(
            (device half *)w2, dextents<int32_t, 2>((int)NF, (int)p.gemm.z));
        for (uint i = tid; i < T * NF; i += 128) A[i] = half(0);
        threadgroup_barrier(mem_flags::mem_threadgroup);
        auto tA2 = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(
            Cbuf, dextents<int32_t, 2>((int)p.gemm.z, T));
        auto tC3 = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(
            A, dextents<int32_t, 2>(NF, T));
        for (uint m0 = 0; m0 < T; m0 += 32)
            for (uint k0 = 0; k0 < p.gemm.z; k0 += 64)
                for (uint n0 = 0; n0 < NF; n0 += 32) {
                    auto mA = tA2.slice<64, 32>((int)k0, (int)m0);
                    auto mB = tW2.slice<32, 64>((int)n0, (int)k0);
                    auto mC = tC3.slice<32, 32>((int)n0, (int)m0);
                    op.run(mA, mB, mC);
                }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        // bias + residual + split-scale requant -> output
        for (uint w = tid; w < T * NF; w += 128) {
            uint px = w / NF, i = w % NF;
            uint xi = x0 + px;
            if (xi >= W) continue;
            float v = float(A[px * NF + i]) + float(b2[i]);
            device const half *in = (device const half *)(
                scratch + p.inV.w + xi * p.inV.x + y * p.inV.y);
            v += float(in[i]);
            float s = (i < (uint)HF) ? p.scales.z : p.scales.w;
            v = requant(v, s);
            device half *out = (device half *)(
                scratch + p.outV.w + xi * p.outV.x + y * p.outV.y);
            out[i] = half(v);
        }
    }
}

kernel void fnb32_mpp(device uchar *scratch [[buffer(0)]],
                      device const uchar *wgt [[buffer(1)]],
                      constant FnbParams &p [[buffer(2)]],
                      uint2 tgid [[threadgroup_position_in_grid]],
                      uint tid [[thread_index_in_threadgroup]])
{
    threadgroup half A[128 * KPAD];       // 16 KB
    threadgroup half Cbuf[128 * 64];      // 16 KB — N1 = 2*32
    fnb_mpp_t<32, 128, 1>(scratch, wgt, p, A, Cbuf, tgid, tid);
}

kernel void fnb64_mpp(device uchar *scratch [[buffer(0)]],
                      device const uchar *wgt [[buffer(1)]],
                      constant FnbParams &p [[buffer(2)]],
                      uint2 tgid [[threadgroup_position_in_grid]],
                      uint tid [[thread_index_in_threadgroup]])
{
    threadgroup half A[64 * KPAD];        // 8 KB
    threadgroup half Cbuf[64 * 128];      // 16 KB — N1 = 2*64
    fnb_mpp_t<64, 64, 0>(scratch, wgt, p, A, Cbuf, tgid, tid);
}

// ---------------------------------------------------------------------------
// Channel-parallel ConvNextBlock (f16_ConvNextBlock) — one SIMDGROUP per
// output pixel: lanes split output channels (and K when out < lanes).
// Generated kernel = 1 thread/pixel walking all channels serially; this
// version puts 32 lanes on each pixel. Tile = 4 pixels/threadgroup (128t).
//
//   conv1 3x3 cIn->NF:  lanes 0..HF-1 f=lane c-lo; HF..31 f=lane-HF c-hi;
//                       simd_xor(HF) reduce. (requires cIn == 2*HF split)
//   conv2 1x1 NF->2NF:  lane = out i, dot over NF.
//   conv3 1x1 2NF->NF:  lanes 0..HF-1 i=lane c-lo; HF..31 c-hi; xor reduce;
//                       + bias + residual + requant -> store.
// Only supports cIn0 = NF = 16, cOut1 = 32 (the FSR4 CNB16 shape): guarded
// host-side by manifest nf/ng fields.

struct CnbParams {
    uint4 inV, outV, dims;
    uint4 w0s;      // elem strides (x,y,c,f)
    uint4 w0d;
    uint4 w1s;      // (x,y,c,i) for w1 (1,1,Cin,Cout)
    uint4 w2s;
    uint4 offs0;    // w0, b0, w1, b1
    uint4 offs1;    // w2, b2
    float4 scales;  // x: 1/rcprOS0 (conv1 requant), y: 1/rcprOS1 (relu),
                    // z: outputScale (store)
};

kernel void cnb_mpp(device uchar *scratch [[buffer(0)]],
                    device const uchar *wgt [[buffer(1)]],
                    constant CnbParams &p [[buffer(2)]],
                    uint2 tgid [[threadgroup_position_in_grid]],
                    uint tid [[thread_index_in_threadgroup]])
{
    constexpr int NF = 16, NF2 = 32, HF = 8;
    const uint W = p.dims.x, H = p.dims.y;
    const uint sg = tid / 32, lane = tid % 32;
    const uint xi = tgid.x * 4 + sg, yi = tgid.y;
    threadgroup half TG[4][NF], TG2[4][NF2];

    device const half *w0 = (device const half *)(wgt + p.offs0.x);
    device const half *b0 = (device const half *)(wgt + p.offs0.y);
    device const half *b1 = (device const half *)(wgt + p.offs0.w);
    device const half *w2 = (device const half *)(wgt + p.offs1.x);
    device const half *b2 = (device const half *)(wgt + p.offs1.y);

    // conv1: lane l -> f = l & 7, c-half = l >> 3 ... use l<16 f=l c-lo,
    // l>=16 f=l-16 c-hi (NF=16, cIn=16 split 8+8)
    {
        uint f = lane % NF, cBase = (lane / NF) * HF;
        float acc = 0;
        for (uint ky = 0; ky < p.w0d.y; ky++)
            for (uint kx = 0; kx < p.w0d.x; kx++) {
                int xx = (int)xi + (int)kx - 1, yy = (int)yi + (int)ky - 1;
                if (xx < 0 || yy < 0 || xx >= (int)W || yy >= (int)H) continue;
                device const half *in = (device const half *)(
                    scratch + p.inV.w + (uint)xx * p.inV.x + (uint)yy * p.inV.y);
                device const half *wt = w0 + kx * p.w0s.x + ky * p.w0s.y
                                        + f * p.w0s.w;
                for (uint c = 0; c < HF; c += 4) {
                    half4 v = *(device const half4 *)(in + cBase + c);
                    acc += float(v.x) * float(wt[(cBase + c) * p.w0s.z])
                         + float(v.y) * float(wt[(cBase + c + 1) * p.w0s.z])
                         + float(v.z) * float(wt[(cBase + c + 2) * p.w0s.z])
                         + float(v.w) * float(wt[(cBase + c + 3) * p.w0s.z]);
                }
            }
        acc += simd_shuffle_xor(acc, NF);
        if (lane < (uint)NF) {
            acc += float(b0[f]);
            TG[sg][f] = half(requant(acc, p.scales.x));
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // conv2: lane -> out i, dot over NF
    {
        device const half *w1 = (device const half *)(wgt + p.offs0.z);
        float a = float(b1[lane]);
        for (uint c = 0; c < NF; c += 4) {
            float4 v = float4(TG[sg][c], TG[sg][c + 1],
                              TG[sg][c + 2], TG[sg][c + 3]);
            device const half *wt = w1 + lane * p.w1s.w + c * p.w1s.z;
            a += v.x * float(wt[0]) + v.y * float(wt[p.w1s.z])
               + v.z * float(wt[2 * p.w1s.z]) + v.w * float(wt[3 * p.w1s.z]);
        }
        TG2[sg][lane] = half(requant_relu(a, p.scales.y));
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    // conv3: lane -> out i = lane%NF, c-half; xor reduce; residual; store
    {
        uint i = lane % NF, cBase = (lane / NF) * NF;
        float r = 0;
        for (uint c = 0; c < NF; c += 4) {
            float4 v = float4(TG2[sg][cBase + c], TG2[sg][cBase + c + 1],
                              TG2[sg][cBase + c + 2], TG2[sg][cBase + c + 3]);
            device const half *wt = w2 + i * p.w2s.w + (cBase + c) * p.w2s.z;
            r += v.x * float(wt[0]) + v.y * float(wt[p.w2s.z])
               + v.z * float(wt[2 * p.w2s.z]) + v.w * float(wt[3 * p.w2s.z]);
        }
        r += simd_shuffle_xor(r, NF);
        if (lane < (uint)NF && xi < W) {
            r += float(b2[i]);
            device const half *in = (device const half *)(
                scratch + p.inV.w + xi * p.inV.x + yi * p.inV.y);
            r += float(in[i]);
            device half *out = (device half *)(
                scratch + p.outV.w + xi * p.outV.x + yi * p.outV.y);
            out[i] = half(requant(r, p.scales.z));
        }
    }
}
